{
  "manifest_version": 3,
  "name": "LuxCrypta Prompt Accelerator",
  "short_name": "Prompt Accelerator",
  "version": "1.0.1",
  "description": "Local prompt compression, review, workflows, and carry-forward capsules for AI chat.",
  "homepage_url": "https://luxcrypta.com/prompt-accelerator",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Prompt Accelerator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "review.html"
  },
  "options_page": "options.html",
  "permissions": ["storage", "sidePanel"],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["assets/content-script.js"],
      "css": ["assets/content.css"],
      "run_at": "document_idle"
    }
  ]
}
